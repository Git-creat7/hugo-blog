<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Graph Debug</title>
<script src="/lib/vis-network.min.js"></script>
</head>
<body>
<div id="network" style="width:800px;height:600px;border:1px solid #ccc;"></div>
<script>
var nodes = new vis.DataSet([
    {id: 'a', label: 'Node A', x: 0, y: 0, fixed: {x: true, y: true}, shape: 'dot', size: 20, color: '#3b82f6'},
    {id: 'b', label: 'Node B', x: 300, y: 0, fixed: {x: true, y: true}, shape: 'dot', size: 20, color: '#10b981'},
    {id: 'c', label: 'Node C', x: 0, y: 200, fixed: {x: true, y: true}, shape: 'dot', size: 20, color: '#f59e0b'},
    {id: 'd', label: 'Node D', x: 300, y: 200, fixed: {x: true, y: true}, shape: 'dot', size: 20, color: '#94a3b8'}
]);

var edges = new vis.DataSet([
    {from: 'a', to: 'b', arrows: 'to'},
    {from: 'c', to: 'd', arrows: 'to'}
]);

var options = {
    physics: { enabled: false },
    interaction: { hover: true }
};

var network = new vis.Network(document.getElementById('network'), {nodes: nodes, edges: edges}, options);
console.log('Nodes positions:', nodes.get().map(n => ({id: n.id, x: n.x, y: n.y})));
console.log('Network moved:', network.moveTo);
</script>
</body>
</html>